# 16. Viewsets | gs10

    # - ViewSet : it will automatically create all the CRUD operations based on the methods defined in the viewset class


    # 1) Viewset-class : we have to define all the methods for CRUD operations in the viewset class
        # - list(self, request) : for GET request to get all the records
        # - create(self, request) : for POST request to create a new record
        # - retrieve(self, request, pk=None) : for GET request to get a single record based on the primary key
        # - update(self, request, pk=None) : for PUT request to update a record based on the primary key
        # - partial_update(self, request, pk=None) : for PATCH request to update a record based on the primary key
        # - destroy(self, request, pk=None) : for DELETE request to delete a record based on the primary key


        # Attributes :

        # most used attributes in viewset class are :
        # - basename
        # - action
        # - detail
        # - suffix
        # - name
        # - description

        # least used attributes in viewset class are :
        # - queryset
        # - serializer_class
        # - lookup_field
        # - lookup_url_kwargs
        # - http_method_names
        # - renderer_classes
        # - filter_backends
        # - pagination_class

        # - normal and primary key based url are automatically generated by the router based on the methods defined in the viewset class and the basename provided in the router.register() method.

        # - all create, read, update and delete operations are automatically generated by the router.

# 17. 2) ModelViewSet : it will automatically create all the CRUD operations based on the queryset and serializer_class defined in the viewset class

        # - queryset : it is used to define the queryset for the viewset class
        # - serializer_class : it is used to define the serializer class for the viewset class
        # - all create, read, update and delete operations are automatically generated by the router based on the queryset and serializer_class defined in the viewset class.


# 18. Authentication and Permission | gs11


    # Overview :

    # Authentication :
    # - Basic Authentication : username and password are sent in the header of the request in base64 encoding. It is not secure as the credentials are sent in plain text and can be easily decoded.
    # - Session Authentication : a session is created after successful authentication and is used to maintain the user's state.
    # - Token Authentication : a token is generated after successful authentication and is sent in the header of each subsequent request.
    # - JWT Authentication : a JSON Web Token is generated after successful authentication and is sent in the header of each subsequent request.
    # - Remote User Authentication : it is used to authenticate users based on the remote user header sent by the web server.
    # - Custom Authentication : we can create our own custom authentication class by inheriting from the BaseAuthentication class and implementing the authenticate() method.


    # Permission :
    # - AllowAny : it allows any user to access the view regardless of their authentication status.
    # - IsAuthenticated : it allows only authenticated users to access the view.
    # - IsAdminUser : it allows only admin users to access the view.
    # - IsAuthenticatedOrReadOnly : it allows authenticated users to access the view for any request method, but unauthenticated users can only access the view for safe methods (GET, HEAD,

    # - DjangoModelPermissions : it allows access to the view based on the user's model permissions.
    # - DjangoModelPermissionsOrAnonReadOnly : it allows access to the view based on the
    # - DjangoObjectPermissions : it allows access to the view based on the user's object permissions.
    # - Custom Permission : we can create our own custom permission class by inheriting from the Base


    # 3) token authentication : it store inside the DB in toekn table

        # - INSTALLED_APPS = [
        #     'rest_framework.authtoken',
        # ]

        # - Generate token for a user :

            # 1) - usign admin panel,
            # 2) - using shell command : python manage.py drf_create_token <username>,
            # 3) - using API endpoint : /api-token-auth/ (you have to define this endpoint in the urls.py file)
            # 4) - using signals : we can create a token for a user automatically when the user is created by using signals.

